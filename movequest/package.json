{
  "name": "movequest",
  "version": "7.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.js *.json index.html",
    "format:check": "prettier --check src tests *.ts *.js *.json index.html",
    "serve": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test:ai:live": "node --env-file-if-exists=.env --import tsx scripts/test-ai-live.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  }
}
