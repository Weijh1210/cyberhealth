# Backend only. Keep the real Key in the ignored local .env or server secret manager.
OPENROUTER_API_KEY=
# Tested default. Only the six :free IDs in server/aiConfig.ts are permitted.
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# At most two distinct approved free candidates, no paid/unknown/auto router models.
# MOVEQUEST_AI_FALLBACKS=off
MOVEQUEST_AI_DAILY_LIMIT=8
# Production: persistent private volume; one server process. Default server/data.
# MOVEQUEST_DATA_DIR=/private-persistent-volume/movequest
# MOVEQUEST_COOKIE_SECRET=long-random-secret
PORT=5176
