{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets/|icons/|sw\\.js|workbox-|manifest\\.webmanifest|licenses\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "framework": "vite",
  "functions": {
    "api/life/extract.ts": {
      "includeFiles": "server/prompts/**",
      "maxDuration": 60
    }
  }
}
